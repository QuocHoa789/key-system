NODE_ENV=production
PORT=3000
DB_DRIVER=sqlite
SQLITE_PATH=./data/key-system.sqlite
DATABASE_URL=
JWT_SECRET=replace-with-at-least-32-random-characters
HMAC_SECRET=replace-with-at-least-32-random-characters
KEY_SALT=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
TRUST_PROXY=1
GATE_TTL_SECONDS=600

# Optional PostgreSQL mode:
# DB_DRIVER=postgres
# DATABASE_URL=postgres://user:password@host:5432/key_system
